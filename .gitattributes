# Normalise line endings so the repo is consistent regardless of who clones it.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.sqlite binary

# Keep noise out of GitHub's language stats and diffs.
public/build/** linguist-generated
*.lock -diff
