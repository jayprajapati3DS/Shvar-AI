APP_NAME="Shvar AI Copilot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Local AI (Ollama) -------------------------------------------------------
# AI inference runs on this machine. There is no cloud provider and no API key.
#
# OLLAMA_URL is intentionally server-side only: it is rendered read-only in the
# UI and cannot be changed from the browser. Only localhost-style hosts are
# accepted - see config/ai.php `allowed_hosts`.
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# Change to a model you have actually pulled (`ollama list`). The app detects
# whether this model is installed and tells you if it is not.
OLLAMA_MODEL=qwen3:8b

AI_TEMPERATURE=0.7
AI_TIMEOUT=600
AI_PROBE_TIMEOUT=5
AI_LOGGING_ENABLED=true

# --- Company website research ------------------------------------------------
# The ONE feature that makes an outbound request: it fetches the company website
# you type so the model reads real text instead of recalling from memory.
# Your CRM data is never sent - only an HTTP GET to that URL.
#
# Set false to restore the zero-outbound-request posture.
RESEARCH_FETCH_ENABLED=true
RESEARCH_TIMEOUT=20
RESEARCH_MAX_PAGES=2

# ---- Phase 4 email -------------------------------------------------------
# 'local'   simulates delivery to the local log and contacts nobody.
# 'smtp'    really sends - configure the connection in Settings -> Email first.
# 'outlook' opens the message in your Outlook desktop app; you press Send there.
#           Needs Windows, classic Outlook and extension=com_dotnet in php.ini.
#           See docs/OUTLOOK_INTEGRATION.md
EMAIL_DRIVER=local

# THE SAFETY RAIL. While non-empty, only these addresses can receive email;
# everything else is refused. A leading @ allows a whole domain. Empty means
# no restriction. Put your own address here before switching EMAIL_DRIVER=smtp.
EMAIL_ALLOWED_RECIPIENTS=

# Offer the send button at all. Defaults to on outside production.
EMAIL_ALLOW_TEST_SEND=true
